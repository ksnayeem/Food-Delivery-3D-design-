# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Security & JWT Secrets
JWT_SECRET=nayeem_spices_ultra_secure_jwt_secret_key_2026_!@#$%^
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=nayeem_spices_refresh_secret_key_2026_&*()
JWT_REFRESH_EXPIRES_IN=30d

# PostgreSQL Configuration
DATABASE_URL=postgresql://nayeem_admin:nayeem_spices_password@localhost:5432/nayeem_spices_db
PG_HOST=localhost
PG_PORT=5432
PG_USER=nayeem_admin
PG_PASSWORD=nayeem_spices_password
PG_DATABASE=nayeem_spices_db

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nayeem-spices-backend
KAFKA_GROUP_ID=nayeem-spices-consumer-group
